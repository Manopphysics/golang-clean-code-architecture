# App
APP_HOST=127.0.0.1
APP_PORT=8000
APP_NAME=Python Clean Architecture API
APP_VERSION=1.0.0

# PostgreSQL
POSTGRES_DB_NAME=postgres
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=golang-first-api
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432

# MongoDB
MONGODB_ATLAS_URI=mongodb://root:golang-first-api@127.0.0.1:27017/?authMechanism=SCRAM-SHA-1&authSource=admin
MONGODB_DB_NAME=golang_cleancode_example

# JWT
SECRET_KEY=1234567890
JWT_ACCESS_EXPIRES=86400
JWT_REFRESH_EXPIRES=172800
